generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SALESPERSON
  DEALERSHIP_ADMIN
  PLATFORM_ADMIN
  SHOPPER
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Dealership {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  city           String
  state          String
  logoUrl        String?
  creditApplyUrl String?
  createdAt      DateTime @default(now())

  // No @default here on purpose: existing dealerships (David Stanley
  // Dodge, the demo one) get NULL on migration -- unlimited, unaffected
  // by the paywall. Brand-new dealerships are explicitly given 0 seats
  // in the registration code, so only dealerships created after this
  // shipped are actually gated. NULL always means unlimited/exempt.
  seatLimit            Int?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   String?

  // Set by an admin granting a prospect (e.g. a demo) temporary posting
  // access without needing paid seats yet. NULL means no trial is
  // active. Once past, posting is blocked again unless the dealership
  // has since bought real seats (seatLimit > 0) -- see the posting
  // gate in app/api/videos/route.ts.
  trialEndsAt DateTime?

  users       User[]
  videos      Video[]
  creditLeads CreditLead[]
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  role           Role     @default(SALESPERSON)
  avatarInitials String?
  bio            String?
  createdAt      DateTime @default(now())

  // Shoppers aren't tied to a dealership -- only dealer-side accounts are.
  firstName String?
  lastName  String?
  phone     String?
  // When the user agreed to the calling/texting consent language at
  // signup -- kept as an audit trail, not just a boolean, since TCPA
  // consent records matter if it's ever disputed.
  smsConsentAt DateTime?

  // Defaults to APPROVED so this migration doesn't retroactively lock
  // out every existing dealer account -- new dealer signups are set to
  // PENDING explicitly in the registration code. Shoppers are left at
  // the default since they're never gated on this.
  verificationStatus VerificationStatus @default(APPROVED)

  dealershipId String?
  dealership   Dealership? @relation(fields: [dealershipId], references: [id])

  videos    Video[]
  likes     Like[]
  comments  Comment[]
  following Follow[] @relation("Following")
  followers Follow[] @relation("Followers")
  saved     SavedVideo[]

  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")

  creditLeads          CreditLead[] @relation("CreditLeadsForSeller")
  submittedCreditLeads CreditLead[] @relation("CreditLeadsSubmittedBy")
}

model Follow {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  followerId    String
  follower      User   @relation("Following", fields: [followerId], references: [id])
  followingId   String
  followingUser User   @relation("Followers", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
}

enum VideoStatus {
  PROCESSING
  READY
  FAILED
}

model Video {
  id           String      @id @default(cuid())
  caption      String
  model        String
  tags         String[]    @default([])
  videoUrl     String
  thumbnailUrl String?
  status       VideoStatus @default(PROCESSING)
  createdAt    DateTime    @default(now())

  sellerId String
  seller   User   @relation(fields: [sellerId], references: [id])

  dealershipId String
  dealership   Dealership @relation(fields: [dealershipId], references: [id])

  likes       Like[]
  comments    Comment[]
  saves       SavedVideo[]
  creditLeads CreditLead[]
  messages    Message[]

  @@index([dealershipId, model])
  @@index([createdAt])
}

model Like {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId  String
  user    User   @relation(fields: [userId], references: [id])
  videoId String
  video   Video  @relation(fields: [videoId], references: [id])

  @@unique([userId, videoId])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  userId  String
  user    User  @relation(fields: [userId], references: [id])
  videoId String
  video   Video @relation(fields: [videoId], references: [id])
}

model SavedVideo {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId  String
  user    User   @relation(fields: [userId], references: [id])
  videoId String
  video   Video  @relation(fields: [videoId], references: [id])

  @@unique([userId, videoId])
}

// A credit-application interest lead captured in-app instead of sending
// shoppers straight to the dealership's own site -- keeps attribution
// to the specific salesperson whose reel generated the interest.
model CreditLead {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  name      String
  phone     String
  email     String?
  notes     String?
  status    String   @default("NEW")

  sellerId String
  seller   User   @relation("CreditLeadsForSeller", fields: [sellerId], references: [id])

  dealershipId String
  dealership   Dealership @relation(fields: [dealershipId], references: [id])

  videoId String?
  video   Video?  @relation(fields: [videoId], references: [id])

  submittedById String?
  submittedBy   User?   @relation("CreditLeadsSubmittedBy", fields: [submittedById], references: [id])

  @@index([sellerId, createdAt])
}

model Message {
  id        String    @id @default(cuid())
  body      String
  createdAt DateTime  @default(now())
  readAt    DateTime?

  senderId    String
  sender      User   @relation("SentMessages", fields: [senderId], references: [id])
  recipientId String
  recipient   User   @relation("ReceivedMessages", fields: [recipientId], references: [id])

  // Set only on the automatic "thanks for checking out this vehicle"
  // message sent the first time a shopper likes/comments/shares a reel --
  // never on messages someone typed themselves. Its presence is also how
  // we avoid sending that automatic message more than once per
  // shopper/video pair.
  videoId String?
  video   Video?  @relation(fields: [videoId], references: [id])

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, senderId, createdAt])
}
